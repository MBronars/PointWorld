<?xml version="1.0"?>
<robot name="floating_gripper">

  <link name="root"/>

  <link name="dummy_x">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6"
               ixy="0.0"   ixz="0.0"   iyz="0.0"/>
    </inertial>
  </link>

  <joint name="joint_x" type="prismatic">
    <parent link="root"/>
    <child link="dummy_x"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="1000" velocity="10"/>
  </joint>

  <link name="gripper">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="5.0" iyy="5.0" izz="5.0"
               ixy="0.0"   ixz="0.0"   iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="floating_gripper_cylinder.stl"/>
      </geometry>
      <material name="tan">
        <color rgba="0.82 0.71 0.55 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="floating_gripper_cylinder.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_y" type="prismatic">
    <parent link="dummy_x"/>
    <child link="gripper"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="1000" velocity="10"/>
  </joint>

</robot>